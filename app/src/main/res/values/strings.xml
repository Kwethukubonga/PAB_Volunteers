    <!-- Volunteer testimonials -->
    <string name="eyebrow_testimonials">Volunteer Stories</string>
    <string name="testimonials_heading">Hear from Our Volunteers</string>
    <string name="testimonial_1_name">Silke Sturm</string>
    <string name="testimonial_1_country">Germany</string>
    <string name="testimonial_1_quote">"Philisa Abafazi Bethu\'s work accepts everyone as they are and encourages individual development. I have watched an organisation grow from Lucinda\'s garage into a wonderful women and family centre for almost 13 years now. It was not just an internship, it became family."</string>
    <string name="testimonial_2_name">Carley Anderson</string>
    <string name="testimonial_2_country">USA</string>
    <string name="testimonial_2_quote">"It is a remarkable feeling to walk into a new space and instantly feel welcomed and appreciated, and Lucinda and the whole PAB team invited us in with open arms. I could not be more thankful to have contributed, in even the smallest capacity, to PAB\'s passion-fuelled work."</string>
    <string name="testimonial_3_name">Natalie Decker</string>
    <string name="testimonial_3_country">USA</string>
    <string name="testimonial_3_quote">"Shortly after starting, I felt so welcomed. Seeing how much Philisa Abafazi contributes to their community was an eye-opening experience. Volunteering with PAB gave me a whole new perspective of South Africa."</string>
    <string name="testimonial_4_name">Michelle Mahina Schlachter</string>
    <string name="testimonial_4_country">Switzerland</string>
    <string name="testimonial_4_quote">"I certainly do not regret having decided to get involved in PAB\'s projects and learn from the people of the Lavender Hill community. From day one they made me feel at home, and I am happy to say that I found a second home in Cape Town."</string>

