    <!-- Why Volunteer -->
    <string name="eyebrow_why_volunteer">Why Volunteer?</string>
    <string name="why_volunteer_heading">Why Volunteer with Philisa?</string>
    <string name="why_1_title">Make a Real Difference</string>
    <string name="why_1_body">Your time creates tangible impact for women, children, and families in Lavender Hill and the surrounding communities.</string>
    <string name="why_2_title">Grow Your Skills</string>
    <string name="why_2_body">Take part in hands-on community work that builds real, practical experience alongside our team.</string>
    <string name="why_3_title">Join a Caring Community</string>
    <string name="why_3_body">Work alongside a dedicated team united by hope, healing, and humanity.</string>
    <string name="why_4_title">Be Part of the Change</string>
    <string name="why_4_body">Help bring lasting change to a community facing real challenges, one family at a time.</string>
    <string name="why_volunteer_image_desc">Volunteers joining hands together</string>

    <!-- Impact area -->
    <string name="impact_area_heading">Where We Work</string>
    <string name="impact_area_body">Lavender Hill is home to around 100 000 people, including five informal settlements, many facing high unemployment and daily hardship. Since 2008, Philisa Abafazi Bethu has stood alongside this community, one family at a time.</string>
    <string name="impact_area_stat_founded_value">2008</string>
