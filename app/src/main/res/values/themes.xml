<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Colours come from values/colors.xml and values-night/colors.xml, so one theme covers both modes. -->
    <style name="Base.Theme.PAB" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/source_sans_3</item>
        <item name="fontFamily">@font/source_sans_3</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/purple_900</item>
        <item name="colorAccent">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Switches and other secondary controls, which were Material's default teal. -->
        <item name="colorSecondary">@color/purple_500</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- Material 3 fills these in itself when they are left out, in its own purple.
             They are the tinted neutrals: lavender rather than grey (K7). -->
        <item name="colorPrimaryContainer">@color/tile_lavender</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>
        <item name="colorSecondaryContainer">@color/purple_100</item>
        <item name="colorOnSecondaryContainer">@color/accent</item>
        <item name="colorSurfaceVariant">@color/tile_lavender</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="android:colorBackground">@color/background_cream</item>
        <item name="android:windowBackground">@color/background_cream</item>
        <item name="android:statusBarColor">@color/purple_900</item>
        <!-- Android 8.0 cannot show dark bar buttons, so its bar stays black. Newer versions: values-v27. -->
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="materialButtonStyle">@style/Widget.PAB.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.PAB.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.PAB.BottomNavigation</item>
    </style>

    <style name="Theme.PAB_Volunteers" parent="Base.Theme.PAB" />

    <!-- A plain colour rather than the header shape: Android can only reuse the window
         background for its own launch screen when it is a colour it can read (see values-v31). -->
    <style name="Theme.PAB_Volunteers.Splash">
        <item name="android:windowBackground">@color/purple_700</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>
