<?xml version="1.0" encoding="utf-8"?>
<!-- An activity in full. A standard top bar (E10) with share and save, the photo, what and when,
     directions and the calendar, help on the day (K12), and Join pinned at the bottom (K6). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_xs"
        android:paddingEnd="@dimen/spacing_xs">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/activity_details_title"
            android:textAppearance="@style/TextAppearance.PAB.Title" />

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_share_activity"
            android:src="@drawable/ic_share"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnFavourite"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_save_favourite"
            android:src="@drawable/ic_heart_outline"
            app:tint="@color/accent" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_normal"
        android:background="@color/divider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/details_photo_height"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/screen_gutter"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProgramme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_soft"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    tools:text="Community Feeding" />

                <TextView
                    android:id="@+id/tvStatus"
                    style="@style/Widget.PAB.StatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    tools:text="4 of 12 spots left" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.PAB.Display"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                tools:text="Community Soup Kitchen" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PAB.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/screen_gutter"
                app:contentPadding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="?android:attr/listDivider"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/rowDateTime"
                        layout="@layout/item_detail_row" />

                    <include
                        android:id="@+id/rowLocation"
                        layout="@layout/item_detail_row" />

                    <include
                        android:id="@+id/rowRole"
                        layout="@layout/item_detail_row" />

                    <include
                        android:id="@+id/rowSpots"
                        layout="@layout/item_detail_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Directions in the maps app, and the activity added to the phone's calendar (I3). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDirections"
                    style="@style/Widget.PAB.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:text="@string/action_directions"
                    android:textColor="@color/accent"
                    app:icon="@drawable/ic_directions"
                    app:iconTint="@color/accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalendar"
                    style="@style/Widget.PAB.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:text="@string/action_add_to_calendar"
                    android:textColor="@color/accent"
                    app:icon="@drawable/ic_calendar"
                    app:iconTint="@color/accent" />
            </LinearLayout>

            <!-- On the day of an activity the volunteer has joined: quick ways to get help. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNeedHelp"
                style="@style/Widget.PAB.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/safety_bg"
                app:contentPadding="@dimen/spacing_md"
                app:strokeColor="@color/safety_line">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/safety_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/need_help_title"
                            android:textColor="@color/safety_text"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/need_help_subtitle"
                            android:textColor="@color/safety_text"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.PAB.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:text="@string/label_description" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:lineSpacingMultiplier="1.3"
                android:textAppearance="@style/TextAppearance.PAB.Body"
                tools:text="Cook, pack and serve meals for families across Lavender Hill." />

            <!-- "How did it go?" Only on a finished activity the volunteer was on. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFeedback"
                style="@style/Widget.PAB.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/feedback_title"
                        android:textAppearance="@style/TextAppearance.PAB.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/feedback_subtitle"
                        android:textAppearance="@style/TextAppearance.PAB.Caption" />

                    <LinearLayout
                        android:id="@+id/layoutFeedbackForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RatingBar
                            android:id="@+id/ratingFeedback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:contentDescription="@string/feedback_rating_label"
                            android:numStars="5"
                            android:progressBackgroundTint="@color/divider"
                            android:progressTint="@color/accent"
                            android:rating="0"
                            android:secondaryProgressTint="@color/accent"
                            android:stepSize="1" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilFeedbackComment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:hint="@string/feedback_comment_hint"
                            app:counterEnabled="true"
                            app:counterMaxLength="500">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFeedbackComment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top"
                                android:importantForAutofill="no"
                                android:inputType="textMultiLine|textCapSentences"
                                android:maxLength="500"
                                android:minLines="2" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendFeedback"
                            style="@style/Widget.PAB.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:text="@string/feedback_send" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFeedbackDone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.PAB.Body"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quiet on purpose: there when it is needed, without alarming anyone. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportConcern"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/action_report_concern"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                app:icon="@drawable/ic_flag"
                app:iconTint="@color/text_secondary" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_normal"
        android:background="@color/divider" />

    <!-- Pinned within thumb reach. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJoin"
            style="@style/Widget.PAB.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_join_activity" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeave"
            style="@style/Widget.PAB.Button.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_leave_activity"
            android:visibility="gone" />

        <!-- Shown while there is no connection, so nobody taps Join and waits. -->
        <TextView
            android:id="@+id/tvJoinHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:text="@string/join_needs_connection"
            android:textAppearance="@style/TextAppearance.PAB.Caption"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
