<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_header"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/action_back"
                    android:padding="@dimen/spacing_sm"
                    android:src="@drawable/ic_back"
                    app:tint="@color/text_on_purple" />

                <TextView
                    android:id="@+id/tvProgramme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:textColor="@color/text_on_purple_muted"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    tools:text="Community Feeding" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/TextAppearance.PAB.Display"
                    android:textSize="26sp"
                    tools:text="October Community Kitchen" />

                <TextView
                    android:id="@+id/tvStatus"
                    style="@style/Widget.PAB.StatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    tools:text="Open" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PAB.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_lg"
                app:contentPadding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="?android:attr/listDivider"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/rowDateTime"
                        layout="@layout/item_detail_row" />

                    <include
                        android:id="@+id/rowLocation"
                        layout="@layout/item_detail_row" />

                    <include
                        android:id="@+id/rowRole"
                        layout="@layout/item_detail_row" />

                    <include
                        android:id="@+id/rowSpots"
                        layout="@layout/item_detail_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/spacing_lg"
                style="@style/TextAppearance.PAB.FieldLabel"
                android:text="@string/label_description" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:lineSpacingMultiplier="1.3"
                android:textAppearance="@style/TextAppearance.PAB.Body"
                tools:text="Cook, pack and serve meals for families across Lavender Hill." />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_normal"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJoin"
            style="@style/Widget.PAB.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_join_activity" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeave"
            style="@style/Widget.PAB.Button.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_leave_activity"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
