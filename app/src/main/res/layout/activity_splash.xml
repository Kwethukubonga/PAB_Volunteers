<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_header"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xl">

    <ImageView
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/org_name"
        android:src="@drawable/logo_philisa" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:gravity="center"
        android:letterSpacing="0.02"
        android:text="@string/org_name"
        android:textColor="@color/text_on_purple"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:gravity="center"
        android:letterSpacing="0.14"
        android:text="@string/org_subtitle"
        android:textAllCaps="true"
        android:textColor="@color/text_on_purple_muted"
        android:textSize="@dimen/text_caption" />

</LinearLayout>
