<?xml version="1.0" encoding="utf-8"?>
<!-- Settings as groups of rows: Account, Appearance, Notifications, About, then Sign out and
     Delete account at the very bottom, away from everyday settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:orientation="vertical">

    <include
        android:id="@+id/offlineBanner"
        layout="@layout/view_offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_header"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/action_back"
            android:padding="@dimen/spacing_sm"
            android:src="@drawable/ic_back"
            app:tint="@color/text_on_purple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:accessibilityHeading="true"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.PAB.Display"
            android:textSize="@dimen/text_display" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Account -->
            <TextView
                style="@style/TextAppearance.PAB.SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:accessibilityHeading="true"
                android:text="@string/settings_account" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PAB.Card.Settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowSignedIn"
                        layout="@layout/item_settings_row" />

                    <!-- Volunteers only: name, phone, area and programmes. -->
                    <View
                        android:id="@+id/dividerEditProfile"
                        style="@style/Widget.PAB.SettingsDivider" />

                    <include
                        android:id="@+id/rowEditProfile"
                        layout="@layout/item_settings_row" />

                    <!-- Only for accounts with a password; Google accounts change theirs at Google. -->
                    <View
                        android:id="@+id/dividerChangePassword"
                        style="@style/Widget.PAB.SettingsDivider" />

                    <include
                        android:id="@+id/rowChangePassword"
                        layout="@layout/item_settings_row" />

                    <!-- Hidden only on phones without a fingerprint sensor that can guard a key. -->
                    <View
                        android:id="@+id/dividerFingerprint"
                        style="@style/Widget.PAB.SettingsDivider" />

                    <!-- Adds "Sign in as …" to the Welcome screen, so coming back is one touch. -->
                    <include
                        android:id="@+id/rowFingerprint"
                        layout="@layout/item_settings_switch_row" />

                    <!-- Only while fingerprint sign-in is on. Suggested for admins: their phones
                         show volunteers' details. -->
                    <View
                        android:id="@+id/dividerAppLock"
                        style="@style/Widget.PAB.SettingsDivider" />

                    <include
                        android:id="@+id/rowAppLock"
                        layout="@layout/item_settings_switch_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Safety: emergency contact, clearance and reporting a concern. Volunteers only. -->
            <LinearLayout
                android:id="@+id/sectionSafety"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.PAB.SettingsSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_safety" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.PAB.Card.Settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Volunteers only: who "I need help" offers to text. -->
                        <include
                            android:id="@+id/rowEmergencyContact"
                            layout="@layout/item_settings_row" />

                        <View
                            android:id="@+id/dividerEmergencyContact"
                            style="@style/Widget.PAB.SettingsDivider" />

                        <include
                            android:id="@+id/rowClearance"
                            layout="@layout/item_settings_row" />

                        <View
                            android:id="@+id/dividerClearance"
                            style="@style/Widget.PAB.SettingsDivider" />

                        <include
                            android:id="@+id/rowReportConcern"
                            layout="@layout/item_settings_row" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Appearance -->
            <TextView
                style="@style/TextAppearance.PAB.SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_xl"
                android:accessibilityHeading="true"
                android:text="@string/settings_appearance" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PAB.Card.Settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowTheme"
                        layout="@layout/item_settings_row" />

                    <RadioGroup
                        android:id="@+id/radioTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/settings_choice_inset"
                        android:paddingEnd="@dimen/spacing_md"
                        android:paddingBottom="@dimen/spacing_sm">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioThemeSystem"
                            style="@style/Widget.PAB.SettingsRadio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_theme_follow_phone" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioThemeLight"
                            style="@style/Widget.PAB.SettingsRadio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_theme_light" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioThemeDark"
                            style="@style/Widget.PAB.SettingsRadio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_theme_dark" />
                    </RadioGroup>

                    <View style="@style/Widget.PAB.SettingsDivider" />

                    <include
                        android:id="@+id/rowLanguage"
                        layout="@layout/item_settings_row" />

                    <!-- One row per language, so longer isiXhosa and Afrikaans names never shrink. -->
                    <RadioGroup
                        android:id="@+id/radioLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/settings_choice_inset"
                        android:paddingEnd="@dimen/spacing_md"
                        android:paddingBottom="@dimen/spacing_sm">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioLanguageEnglish"
                            style="@style/Widget.PAB.SettingsRadio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/language_english" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioLanguageXhosa"
                            style="@style/Widget.PAB.SettingsRadio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/language_xhosa" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioLanguageAfrikaans"
                            style="@style/Widget.PAB.SettingsRadio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/language_afrikaans" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Notifications. Volunteers see the first two rows, admins only the third. -->
            <TextView
                style="@style/TextAppearance.PAB.SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_xl"
                android:accessibilityHeading="true"
                android:text="@string/settings_notifications" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PAB.Card.Settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowNotifyActivities"
                        layout="@layout/item_settings_switch_row" />

                    <include
                        android:id="@+id/rowNotifyAnnouncements"
                        layout="@layout/item_settings_switch_row" />

                    <include
                        android:id="@+id/rowNotifyFull"
                        layout="@layout/item_settings_switch_row" />

                    <!-- Volunteers only: how long before a joined activity to be reminded (K14). -->
                    <include
                        android:id="@+id/rowReminders"
                        layout="@layout/item_settings_row" />

                    <!-- Shown while the phone itself is blocking this app's notifications. -->
                    <LinearLayout
                        android:id="@+id/layoutNotificationsBlocked"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_notifications_blocked"
                            android:textAppearance="@style/TextAppearance.PAB.Caption" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTurnOnNotifications"
                            style="@style/Widget.PAB.Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:text="@string/settings_notifications_turn_on" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About -->
            <TextView
                style="@style/TextAppearance.PAB.SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_xl"
                android:accessibilityHeading="true"
                android:text="@string/settings_about" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PAB.Card.Settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowContact"
                        layout="@layout/item_settings_row" />

                    <View style="@style/Widget.PAB.SettingsDivider" />

                    <include
                        android:id="@+id/rowVersion"
                        layout="@layout/item_settings_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/status_error_text"
                android:visibility="gone" />

            <!-- Sign out and delete sit apart from everyday settings, so they aren't tapped by accident. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignOut"
                style="@style/Widget.PAB.Button.DestructiveFilled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/action_sign_out"
                app:icon="@drawable/ic_logout"
                app:iconTint="@color/on_destructive" />

            <!-- Hidden for admins, whose accounts are managed by the organisation. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteAccount"
                style="@style/Widget.PAB.Button.Destructive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:text="@string/settings_delete_account" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
