<?xml version="1.0" encoding="utf-8"?>
<!-- One page of the first-run introduction. Centred, with room for long text in isiXhosa
     and Afrikaans and at larger text sizes. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="200dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/spacing_xl">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_interest_icon"
            android:contentDescription="@null"
            android:padding="@dimen/spacing_lg"
            app:tint="@color/accent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.PAB.Title"
            android:textSize="@dimen/text_title" />

        <TextView
            android:id="@+id/tvBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.PAB.Body" />
    </LinearLayout>
</ScrollView>
