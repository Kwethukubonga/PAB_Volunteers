<?xml version="1.0" encoding="utf-8"?>
<!-- One line of a plan: a start time or an icon, then a title and a detail line underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_sm">

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:textColor="@color/accent"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="09:00"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/ivTile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="@dimen/spacing_md"
        android:background="@drawable/bg_chip_soft"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PAB.Subtitle"
            tools:text="Community Soup Kitchen" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PAB.Caption"
            tools:text="Community Feeding · Kitchen helper" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvWhen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:textAppearance="@style/TextAppearance.PAB.Caption"
        android:visibility="gone"
        tools:text="in 3 days" />
</LinearLayout>
