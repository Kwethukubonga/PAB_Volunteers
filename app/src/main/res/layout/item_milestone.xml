<?xml version="1.0" encoding="utf-8"?>
<!-- One milestone on the Profile screen. Read by TalkBack as one item, with its progress. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_card"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_xs"
    android:paddingTop="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_md">

    <ImageView
        android:id="@+id/ivMilestone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_chip_soft"
        android:importantForAccessibility="no"
        android:padding="8dp" />

    <TextView
        android:id="@+id/tvMilestoneTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.PAB.Caption"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMilestoneProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.PAB.Caption" />
</LinearLayout>
