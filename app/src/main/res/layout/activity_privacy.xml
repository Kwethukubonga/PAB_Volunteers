<?xml version="1.0" encoding="utf-8"?>
<!-- What the app keeps about a volunteer, why, and who can see it, with a way to take a
     copy of it away. Written for a volunteer to read, not as a legal notice (I5). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_header"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/spacing_lg">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/action_back"
            android:padding="@dimen/spacing_sm"
            android:src="@drawable/ic_back"
            app:tint="@color/text_on_purple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:accessibilityHeading="true"
            android:text="@string/privacy_title"
            android:textAppearance="@style/TextAppearance.PAB.Display"
            android:textSize="@dimen/text_display" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/spacing_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_intro"
                android:textAppearance="@style/TextAppearance.PAB.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:accessibilityHeading="true"
                android:text="@string/privacy_what_heading"
                android:textAppearance="@style/TextAppearance.PAB.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/privacy_what"
                android:textAppearance="@style/TextAppearance.PAB.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:accessibilityHeading="true"
                android:text="@string/privacy_who_heading"
                android:textAppearance="@style/TextAppearance.PAB.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/privacy_who"
                android:textAppearance="@style/TextAppearance.PAB.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:accessibilityHeading="true"
                android:text="@string/privacy_rights_heading"
                android:textAppearance="@style/TextAppearance.PAB.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/privacy_rights"
                android:textAppearance="@style/TextAppearance.PAB.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadData"
                style="@style/Widget.PAB.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/privacy_download" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/privacy_download_desc"
                android:textAppearance="@style/TextAppearance.PAB.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
