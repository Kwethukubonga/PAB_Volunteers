<?xml version="1.0" encoding="utf-8"?>
<!-- The one-tap ways in, side by side as in Collective: Google, and fingerprint once it is set
     up on this phone (otherwise Google takes the whole row). White pills, so they read the same
     on the purple Explore page and the cream sign-in screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/gap_sm"
    android:orientation="horizontal"
    android:showDividers="middle">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoogle"
        style="@style/Widget.PAB.Button.SignInOption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/sign_in_option_google"
        app:icon="@drawable/ic_google"
        app:iconTint="@null" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFingerprint"
        style="@style/Widget.PAB.Button.SignInOption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/sign_in_option_fingerprint"
        android:visibility="gone"
        app:icon="@drawable/ic_fingerprint"
        app:iconTint="@color/purple_700" />
</LinearLayout>
