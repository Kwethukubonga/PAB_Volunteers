<?xml version="1.0" encoding="utf-8"?>
<!-- Home as a planner (K9): what is next, the coming week, the plan for the picked day, then
     one summary line instead of four stat tiles (E7), and the latest word from Philisa. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_cream"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Greeting. Extra space at the bottom for the next-activity card to sit over. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_header"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingTop="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:paddingBottom="@dimen/home_card_overlap_space">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_on_purple"
                    android:textSize="@dimen/text_body"
                    tools:text="Saturday 24 October" />

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.PAB.Display"
                    android:textSize="26sp"
                    tools:text="Good morning, Nomsa" />
            </LinearLayout>

            <!-- The next activity, or a nudge to find one. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/home_card_overlap"
                android:layout_marginEnd="@dimen/spacing_md"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/home_next_card"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Soft circles in the corner, as in the brand panels. -->
                    <View
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-26dp"
                        android:layout_marginEnd="-26dp"
                        android:alpha="0.55"
                        android:background="@drawable/bg_circle_light"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-30dp"
                        android:layout_marginEnd="40dp"
                        android:alpha="0.45"
                        android:background="@drawable/bg_circle_lighter"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <TextView
                            android:id="@+id/tvNextWhen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_on_purple"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp"
                            android:textColor="@color/text_on_purple"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold"
                            tools:text="Next up · today" />

                        <TextView
                            android:id="@+id/tvNextTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:layout_marginEnd="@dimen/spacing_xl"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.PAB.Display"
                            android:textSize="21sp"
                            tools:text="Community Soup Kitchen" />

                        <TextView
                            android:id="@+id/tvNextTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:drawablePadding="@dimen/spacing_xs"
                            android:gravity="center_vertical"
                            android:textColor="@color/text_on_purple"
                            android:textSize="@dimen/text_body"
                            app:drawableStartCompat="@drawable/ic_schedule_small"
                            tools:text="09:00 – 12:00" />

                        <TextView
                            android:id="@+id/tvNextPlace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:drawablePadding="@dimen/spacing_xs"
                            android:gravity="center_vertical"
                            android:textColor="@color/text_on_purple"
                            android:textSize="@dimen/text_body"
                            app:drawableStartCompat="@drawable/ic_location_small"
                            tools:text="Philisa Centre, 55 Strauss Rd" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- The coming week, one tap per day. -->
            <TextView
                style="@style/TextAppearance.PAB.SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_lg"
                android:accessibilityHeading="true"
                android:text="@string/home_this_week" />

            <LinearLayout
                android:id="@+id/layoutWeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_md"
                android:baselineAligned="false"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tvDayHeading"
                style="@style/TextAppearance.PAB.SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_lg"
                android:accessibilityHeading="true"
                tools:text="Today" />

            <LinearLayout
                android:id="@+id/layoutDayPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_md"
                android:background="@drawable/bg_card"
                android:orientation="vertical" />

            <!-- One line instead of the four stat tiles. Opens the Schedule tab. -->
            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm"
                android:textAppearance="@style/TextAppearance.PAB.Body"
                app:drawableStartCompat="@drawable/ic_trophy_small"
                tools:text="3 upcoming · 12 hours completed" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.PAB.SettingsSection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/home_latest" />

                <TextView
                    android:id="@+id/btnSeeCommunity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_target_min"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:text="@string/action_see_all"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <include
                android:id="@+id/rowLatest"
                layout="@layout/item_plan_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <TextView
                android:id="@+id/tvEmptyAnnouncements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:padding="@dimen/spacing_lg"
                android:text="@string/empty_no_announcements"
                android:textAppearance="@style/TextAppearance.PAB.Body"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
