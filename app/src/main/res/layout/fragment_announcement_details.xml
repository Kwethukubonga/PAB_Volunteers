<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_header"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/action_back"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_back"
                app:tint="@color/text_on_purple" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="@color/text_on_purple_muted"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                tools:text="26 Oct 2026" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.PAB.Display"
                android:textSize="26sp"
                tools:text="October Community Kitchen Needs You" />
        </LinearLayout>

        <!-- The message comes first, so the picture supports what was said rather than
             pushing it below the fold. -->
        <TextView
            android:id="@+id/tvBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_lg"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            tools:text="Round off October with our Community Feeding programme's kitchen day." />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImage"
            style="@style/Widget.PAB.Card"
            app:contentPadding="0dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/announcement_image_height"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/label_image_optional"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/layoutThumbsUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:background="@drawable/bg_chip_soft"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm">

            <ImageView
                android:id="@+id/ivThumbsUp"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/action_thumbs_up"
                android:src="@drawable/ic_thumb_up_outline"
                app:tint="@color/purple_700" />

            <TextView
                android:id="@+id/tvThumbsUpCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:textColor="@color/purple_700"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                tools:text="4 thumbs up" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
