<?xml version="1.0" encoding="utf-8"?>
<!-- Three pages shown once, before Welcome, to someone opening the app for the first time
     (K8). The pager fills the screen; Skip sits over the photograph at the top and the dots
     and the button sit over the cream at the bottom, so neither moves as the pages change. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSkip"
        style="@style/Widget.PAB.Button.Skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:text="@string/intro_skip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/background_cream"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- One dot per page, added in code so they always match the pages themselves. -->
        <LinearLayout
            android:id="@+id/dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnForward"
            style="@style/Widget.PAB.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intro_next" />
    </LinearLayout>
</FrameLayout>
