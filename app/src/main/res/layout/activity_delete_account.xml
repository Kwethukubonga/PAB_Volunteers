<?xml version="1.0" encoding="utf-8"?>
<!-- Deleting an account in two calm steps. Step 1 says what will be lost, with keeping the
     account as the big button. Step 2 confirms it's really them and asks for the word. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:orientation="vertical">

    <include
        android:id="@+id/offlineBanner"
        layout="@layout/view_offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_header"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/spacing_lg">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/action_back"
            android:padding="@dimen/spacing_sm"
            android:src="@drawable/ic_back"
            app:tint="@color/text_on_purple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:accessibilityHeading="true"
            android:text="@string/delete_account_title"
            android:textAppearance="@style/TextAppearance.PAB.Display"
            android:textSize="@dimen/text_display" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Step 1: what will be lost -->
            <LinearLayout
                android:id="@+id/stepWhatYouLose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/delete_account_intro"
                    android:textAppearance="@style/TextAppearance.PAB.Subtitle" />

                <ProgressBar
                    android:id="@+id/progressSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/spacing_md" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSummary"
                    style="@style/Widget.PAB.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLoseHours"
                            style="@style/Widget.PAB.LossListItem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tvLoseUpcoming"
                            style="@style/Widget.PAB.LossListItem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tvLoseHistory"
                            style="@style/Widget.PAB.LossListItem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <TextView
                            style="@style/Widget.PAB.LossListItem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/delete_account_lose_profile" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/delete_account_cannot_undo"
                    android:textAppearance="@style/TextAppearance.PAB.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKeepAccount"
                    style="@style/Widget.PAB.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:text="@string/delete_account_keep" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContinue"
                    style="@style/Widget.PAB.Button.Destructive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/delete_account_continue" />
            </LinearLayout>

            <!-- Step 2: confirm it's them, then type the word -->
            <LinearLayout
                android:id="@+id/stepConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvConfirmHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/delete_account_confirm_heading"
                    android:textAppearance="@style/TextAppearance.PAB.Title" />

                <TextView
                    android:id="@+id/tvConfirmBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/TextAppearance.PAB.Body" />

                <!-- Email accounts confirm with their password. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:hint="@string/label_password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Google accounts confirm by picking the same Google account again. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmGoogle"
                    style="@style/Widget.PAB.Button.Google"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/delete_account_confirm_google"
                    app:icon="@drawable/ic_google"
                    app:iconTint="@null" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConfirmWord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmWord"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textCapCharacters|textNoSuggestions" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/status_error_text"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    style="@style/Widget.PAB.Button.DestructiveFilled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:enabled="false"
                    android:text="@string/settings_delete_account" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKeepAccountConfirm"
                    style="@style/Widget.PAB.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/delete_account_keep" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
