<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Sign in sits above the fold. Everything below it is supporting detail. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_header"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/spacing_xl">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_gravity="start"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/action_back"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_back"
                app:tint="@color/text_on_purple" />

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo_philisa" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center"
                android:text="@string/org_name"
                android:textAppearance="@style/TextAppearance.PAB.Title"
                android:textColor="@color/text_on_purple" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:text="@string/org_tagline"
                android:textColor="@color/text_on_purple_muted"
                android:textSize="@dimen/text_body" />

            <!-- Laid out as in Collective: the main way in full width, then the one-tap ones
                 side by side under "or". -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignInWithEmail"
                style="@style/Widget.PAB.Button.Google"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/sign_in_with_email"
                app:icon="@drawable/ic_email"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_sm"
                app:iconTint="@color/purple_700" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center_vertical"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stroke_normal"
                    android:layout_weight="1"
                    android:background="@color/text_on_purple_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/sign_in_or"
                    android:textColor="@color/text_on_purple_muted"
                    android:textSize="@dimen/text_caption" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stroke_normal"
                    android:layout_weight="1"
                    android:background="@color/text_on_purple_muted" />
            </LinearLayout>

            <include
                android:id="@+id/signInOptions"
                layout="@layout/view_sign_in_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md" />

        </LinearLayout>

        <!-- Programmes, as a strip rather than a long grid. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:text="@string/programmes_heading"
                android:textAppearance="@style/TextAppearance.PAB.Title" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:clipToPadding="false"
                android:paddingEnd="@dimen/screen_gutter"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/programmeStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Volunteer Testimonials -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/purple_900"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:text="@string/testimonials_heading"
                android:textColor="@color/text_on_purple"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:clipToPadding="false"
                android:paddingEnd="@dimen/screen_gutter"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/incTestimonial1"
                        layout="@layout/item_testimonial" />

                    <include
                        android:id="@+id/incTestimonial2"
                        layout="@layout/item_testimonial" />

                    <include
                        android:id="@+id/incTestimonial3"
                        layout="@layout/item_testimonial" />

                    <include
                        android:id="@+id/incTestimonial4"
                        layout="@layout/item_testimonial" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/purple_800"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/spacing_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/org_name"
                android:textColor="@color/text_on_purple"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/footer_email"
                android:textColor="@color/text_on_purple_muted"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/footer_phone"
                android:textColor="@color/text_on_purple_muted"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:text="@string/footer_address"
                android:textColor="@color/text_on_purple_muted"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/footer_copyright"
                android:textColor="@color/text_on_purple_muted"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
