<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_cream"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_header"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingTop="@dimen/spacing_xl"
                android:paddingEnd="@dimen/screen_gutter"
                android:paddingBottom="@dimen/spacing_xl">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/admin_overview_title"
                    android:textAppearance="@style/TextAppearance.PAB.Display" />

                <TextView
                    android:id="@+id/tvAdminName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textColor="@color/text_on_purple_muted"
                    android:textSize="@dimen/text_caption"
                    tools:text="Signed in as admin@philisa.org" />
            </LinearLayout>

            <!-- At a glance (E7): one row per number, saying what it counts, and tapping a row
                 opens its tab. Easier to read than three big numbers with small labels. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:accessibilityHeading="true"
                android:text="@string/overview_at_a_glance"
                android:textAppearance="@style/TextAppearance.PAB.Title" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PAB.Card.Settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/screen_gutter">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowVolunteers"
                        layout="@layout/item_settings_row" />

                    <View style="@style/Widget.PAB.SettingsDivider" />

                    <include
                        android:id="@+id/rowActivities"
                        layout="@layout/item_settings_row" />

                    <View style="@style/Widget.PAB.SettingsDivider" />

                    <include
                        android:id="@+id/rowSignups"
                        layout="@layout/item_settings_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_xl"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:text="@string/quick_actions_heading"
                android:textAppearance="@style/TextAppearance.PAB.Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:orientation="vertical">

                <include android:id="@+id/actionCreateActivity" layout="@layout/item_quick_action" />

                <include android:id="@+id/actionPostAnnouncement" layout="@layout/item_quick_action" />

                <include android:id="@+id/actionConcerns" layout="@layout/item_quick_action" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_xl"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:text="@string/recent_volunteers_heading"
                android:textAppearance="@style/TextAppearance.PAB.Title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentVolunteers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_volunteer" />

            <TextView
                android:id="@+id/tvEmptyVolunteers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingTop="@dimen/spacing_lg"
                android:paddingEnd="@dimen/screen_gutter"
                android:paddingBottom="@dimen/spacing_lg"
                android:text="@string/empty_no_volunteers"
                android:textAppearance="@style/TextAppearance.PAB.Body"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
