<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Who they are: a colour of their own (K11), their name, ID and how long they've helped. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_header"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg">

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="@dimen/avatar_size_lg"
                android:layout_height="@dimen/avatar_size_lg"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/white"
                android:textSize="@dimen/text_display"
                android:textStyle="bold"
                tools:text="N" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.PAB.Display"
                    android:textSize="22sp"
                    tools:text="Nomsa Dlamini" />

                <TextView
                    android:id="@+id/tvVolunteerId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_on_purple"
                    android:textSize="@dimen/text_caption"
                    tools:text="VOL-2026-ABC123 · volunteering for 8 months" />
            </LinearLayout>
        </LinearLayout>

        <!-- Background check, as recorded by Philisa's admins. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardClearance"
            style="@style/Widget.PAB.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:focusable="true"
            app:contentPadding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivClearance"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_clearance"
                        android:textAppearance="@style/TextAppearance.PAB.Subtitle" />

                    <TextView
                        android:id="@+id/tvClearance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PAB.Caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvClearancePill"
                    style="@style/Widget.PAB.StatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:visibility="gone"
                    tools:text="Cleared"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.PAB.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_lg"
            android:accessibilityHeading="true"
            android:text="@string/milestones_heading" />

        <!-- Two rows of two, so each badge has room for its words. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:baselineAligned="false"
            android:divider="@drawable/gap_sm"
            android:orientation="horizontal"
            android:showDividers="middle">

            <include android:id="@+id/milestone1" layout="@layout/item_milestone" />

            <include android:id="@+id/milestone2" layout="@layout/item_milestone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:baselineAligned="false"
            android:divider="@drawable/gap_sm"
            android:orientation="horizontal"
            android:showDividers="middle">

            <include android:id="@+id/milestone3" layout="@layout/item_milestone" />

            <include android:id="@+id/milestone4" layout="@layout/item_milestone" />
        </LinearLayout>

        <!-- Their places, upcoming and past, with when each is (K10). -->
        <TextView
            style="@style/TextAppearance.PAB.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_lg"
            android:accessibilityHeading="true"
            android:text="@string/profile_my_activities" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabsMyActivities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:background="@color/background_cream"
            app:tabIndicatorColor="@color/accent"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/accent"
            app:tabTextColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/layoutMyActivities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:background="@drawable/bg_card"
            android:orientation="vertical" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PAB.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_lg"
            app:contentPadding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="?android:attr/listDivider"
                android:orientation="vertical"
                android:showDividers="middle">

                <include
                    android:id="@+id/rowEmail"
                    layout="@layout/item_detail_row" />

                <include
                    android:id="@+id/rowPhone"
                    layout="@layout/item_detail_row" />

                <include
                    android:id="@+id/rowArea"
                    layout="@layout/item_detail_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.PAB.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:text="@string/label_programme_interest" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupInterests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_lg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditProfile"
            style="@style/Widget.PAB.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:text="@string/action_edit_profile"
            app:icon="@drawable/ic_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            style="@style/Widget.PAB.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:text="@string/action_settings"
            app:icon="@drawable/ic_settings" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
