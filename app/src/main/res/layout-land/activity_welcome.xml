<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape has far less height, so the quote and the button no longer fit stacked.
  The text scrolls on the left and the button stays put on the right, which keeps the
  way in reachable no matter how short the screen is.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/img_hero_rally" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg">

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWelcomeQuote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_quote"
                    android:textAppearance="@style/TextAppearance.PAB.Display" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/welcome_subtitle"
                    android:textColor="@color/text_on_purple_muted"
                    android:textSize="@dimen/text_subtitle" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExplore"
            style="@style/Widget.PAB.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:minHeight="@dimen/button_height"
            android:minWidth="200dp"
            android:text="@string/welcome_cta"
            android:textColor="@color/text_on_purple"
            tools:ignore="RtlSymmetry" />

    </LinearLayout>
</FrameLayout>
