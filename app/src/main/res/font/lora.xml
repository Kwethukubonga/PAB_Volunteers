<?xml version="1.0" encoding="utf-8"?>
<!-- One variable file carries every weight, so the regular and bold the app asks for are
     instances of it rather than two more files. Picking an instance needs API 28; on 26 and
     27 the attribute is ignored, the regular weight is used and Android thickens the bold
     itself, which is what it already did for the stock families. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">

    <font
        android:font="@font/lora_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 400"
        android:fontWeight="400" />

    <font
        android:font="@font/lora_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 700"
        android:fontWeight="700" />
</font-family>
