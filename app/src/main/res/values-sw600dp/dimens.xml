<?xml version="1.0" encoding="utf-8"?>
<!-- Tablets. Phone spacing leaves everything stranded across a wide screen, so the
     gaps, type and avatars all grow. Every layout picks these up without changing. -->
<resources>
    <dimen name="spacing_md">20dp</dimen>
    <dimen name="spacing_lg">40dp</dimen>
    <dimen name="spacing_xl">56dp</dimen>

    <dimen name="text_display">38sp</dimen>
    <dimen name="text_title">26sp</dimen>
    <dimen name="text_subtitle">18sp</dimen>
    <dimen name="text_body">17sp</dimen>
    <dimen name="text_caption">14sp</dimen>

    <dimen name="avatar_size_lg">120dp</dimen>
    <dimen name="avatar_size_sm">56dp</dimen>
    <dimen name="button_height">60dp</dimen>
    <dimen name="announcement_image_height">400dp</dimen>
</resources>
