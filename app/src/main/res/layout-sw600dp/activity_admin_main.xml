<?xml version="1.0" encoding="utf-8"?>
<!-- Tablets (F10): the same tabs as a navigation rail down the side, instead of a phone's bottom
     bar stretched across a wide screen. It stays put on detail screens, as Material expects. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream">

    <include
        android:id="@+id/offlineBanner"
        layout="@layout/view_offline_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/offlineBanner">

        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/navRail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@color/card_background"
            android:paddingTop="@dimen/spacing_md"
            app:elevation="0dp"
            app:itemIconTint="@color/bottom_nav_item"
            app:itemTextColor="@color/bottom_nav_item"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/admin_bottom_nav" />

        <View
            android:layout_width="@dimen/stroke_normal"
            android:layout_height="match_parent"
            android:background="@color/divider" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navHostAdmin"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:defaultNavHost="true"
            app:navGraph="@navigation/admin_nav_graph" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
