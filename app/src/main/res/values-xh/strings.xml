    <string name="settings_privacy">Ubumfihlo</string>
    <string name="settings_privacy_desc">Oko i-app ikugcinayo ngawe</string>
    <string name="privacy_title">Ubumfihlo</string>
    <string name="privacy_intro">IPhilisa Abafazi Bethu igcina okuncinane kangangoko ngawe, igcine kuphela oko ikudingayo ukucwangcisa imisebenzi nokukwazisa ngayo.</string>
    <string name="privacy_what_heading">Oko i-app ikugcinayo</string>
    <string name="privacy_what">Igama lakho, idilesi ye-imeyile, inombolo yefowuni, indawo ohlala kuyo, iinkqubo ozikhethileyo, nemisebenzi ozibhalisele yona. Akukho nto yimbi.</string>
    <string name="privacy_who_heading">Ngubani onokukubona</string>
    <string name="privacy_who">Nguwe, nabalawuli bePhilisa. Amanye amavolontiya akaze azibone iinkcukacha zakho, kwaye akukho luhlu lukawonke-wonke lwamavolontiya. Iindawo zamakhaya akhuselekileyo azikhe ziboniswe kwi-app.</string>
    <string name="privacy_rights_heading">Onokukwenza</string>
    <string name="privacy_rights">Ungazilungisa iinkcukacha zakho kwiHlela iprofayile, uthathe ikopi yayo yonke into i-app eyigcinayo, uze ucime iakhawunti yakho kwiiSetingi, oko kubuyisela izithuba zakho kwamanye amavolontiya. Buza ku-admin@philisaabafazi.org nangantoni na enye.</string>
    <string name="privacy_download">Khuphela idatha yam</string>
    <string name="privacy_download_desc">Igcina ifayile yombhalo eneprofayile yakho nayo yonke imisebenzi ozibhalisele yona, apho ukhetha khona kwifowuni yakho.</string>
    <string name="privacy_download_done">Igciniwe.</string>
    <string name="privacy_download_failed">Ifayile ayikwazanga ukugcinwa. Zama enye ifolda.</string>
    <string name="settings_show_intro">Bonisa intshayelelo kwakhona</string>
    <string name="intro_skip">Tsiba</string>
    <string name="intro_next">Okulandelayo</string>
    <string name="intro_get_started">Qalisa</string>
    <string name="intro_one_title">Wamkelekile — ukhenketho olufutshane</string>
    <string name="intro_one_body">Umzuzu omnye, kwaye ungakutsiba. Ikhaya livula kwiveki yakho usuku ngosuku, okulandelayo kuwe, nezona zintsha zivela kwiPhilisa.</string>
    <string name="intro_two_title">Fumana umsebenzi olingana neveki yakho</string>
    <string name="intro_two_body">Khangela okuvulekileyo, ubone ixesha nendawo, uze uthathe isithuba ngokuchukumisa kanye.</string>
    <string name="intro_four_title">Konke ozibhalisele kuko, kuluhlu olunye</string>
    <string name="intro_four_body">Okusezayo nokugqityiweyo, kunye neeyure ozinikeleyo.</string>
    <string name="intro_three_title">Yiva kwiqela</string>
    <string name="intro_three_body">Izibuyekezo ezivela kwiPhilisa, nobhontsi xa into ihambe kakuhle.</string>
</resources>
