<?xml version="1.0" encoding="utf-8"?>
<!-- The dot under the introduction pages. A TabLayout draws one per page and marks the
     current one as selected, which saves keeping a second list of views in step. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/accent" />
            <size
                android:width="10dp"
                android:height="10dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/divider" />
            <size
                android:width="10dp"
                android:height="10dp" />
        </shape>
    </item>
</selector>
