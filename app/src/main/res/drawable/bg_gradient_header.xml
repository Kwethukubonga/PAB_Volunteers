<?xml version="1.0" encoding="utf-8"?>
<!-- The header band across the app's screens. A solid brand purple rather than a gradient
     (K7): the light end of the old gradient left the small muted text in the headers below
     the contrast it needs. The name is kept so the layouts that use it need no change. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/purple_700" />
</shape>
